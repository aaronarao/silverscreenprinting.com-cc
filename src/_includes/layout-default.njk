<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.defaultTitle }}</title>
  <meta name="description" content="{{ description or site.defaultDescription }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
{% include "seo.njk" %}

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="{{ site.shortName }}">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="preload" href="/fonts/X-SCALE_.TTF" as="font" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="https://use.typekit.net/khy6rau.css">
  <link rel="stylesheet" href="/css/site.css">
  <script src="/js/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
</body>
</html>
