{#- Shared markup: header, menu drawer and footer pieces, and the page building blocks.
    Nunjucks macros don't see the page context, so pass in what they need. -#}
{%- import "icons.njk" as icons -%}

{%- macro chevron() -%}
<svg class="chevron" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endmacro -%}

{#- navList(nav, currentUrl, id)
    `id` keeps submenu ids unique when the same menu appears more than once on a page. -#}
{%- macro navList(nav, currentUrl, id) -%}
<ul class="nav__list">
  {%- for item in nav %}
  {%- if item.children %}
  {%- set subId = id + "-" + loop.index %}
  {#- A `set` inside a for loop doesn't leak out, so capture output instead. #}
  {%- set childActive %}{% for child in item.children %}{% if child.url == currentUrl %}1{% endif %}{% endfor %}{% endset %}
  <li class="nav__item nav__item--has-sub">
    <button class="nav__link{% if childActive | trim %} is-active{% endif %}" type="button" aria-expanded="false" aria-controls="{{ subId }}" data-submenu-toggle>
      <span class="nav__text">{{ item.title }} {{ chevron() }}</span>
    </button>
    <ul class="nav__sub" id="{{ subId }}">
      {%- for child in item.children %}
      <li><a class="nav__sublink" href="{{ child.url }}"{% if child.url == currentUrl %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
      {%- endfor %}
    </ul>
  </li>
  {%- else %}
  <li class="nav__item">
    <a class="nav__link" href="{{ item.url }}"{% if item.url == currentUrl %} aria-current="page"{% endif %}><span class="nav__text">{{ item.title }}</span></a>
  </li>
  {%- endif %}
  {%- endfor %}
</ul>
{%- endmacro -%}

{%- macro socialIcon(icon) -%}
{%- if icon == "facebook" -%}
<svg viewBox="0 0 320 512" aria-hidden="true" focusable="false"><path d="M279.1 288l14.2-92.7h-88.9v-60.1c0-25.4 12.4-50.1 52.2-50.1h40.4V6.3S260.4 0 225.4 0c-73.2 0-121.1 44.4-121.1 124.7v70.6H22.9V288h81.4v224h100.2V288z"/></svg>
{%- elif icon == "instagram" -%}
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.3" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.6" cy="6.4" r="1.3"/></svg>
{%- elif icon == "linkedin" -%}
<svg viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path d="M100.3 448H7.4V148.9h92.9V448zM53.8 108.1C24.1 108.1 0 83.5 0 53.8a53.8 53.8 0 0 1 107.6 0c0 29.7-24.1 54.3-53.8 54.3zM447.9 448h-92.7V302.4c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7V448h-92.8V148.9h89.1v40.8h1.3c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3V448z"/></svg>
{%- elif icon == "youtube" -%}
<svg viewBox="0 0 576 512" aria-hidden="true" focusable="false"><path d="M549.7 124.1c-6.3-23.7-24.8-42.3-48.3-48.6C458.8 64 288 64 288 64S117.2 64 74.6 75.5c-23.5 6.3-42 24.9-48.3 48.6C14.9 167 14.9 256.4 14.9 256.4s0 89.4 11.4 132.3c6.3 23.6 24.8 41.5 48.3 47.8C117.2 448 288 448 288 448s170.8 0 213.4-11.5c23.5-6.3 42-24.2 48.3-47.8 11.4-42.9 11.4-132.3 11.4-132.3s0-89.4-11.4-132.3zM232.1 337.6V175.2l142.7 81.2-142.7 81.2z"/></svg>
{%- endif -%}
{%- endmacro -%}

{%- macro socialList(social) -%}
<ul class="social">
  {%- for s in social %}
  <li><a class="social__link" href="{{ s.url }}" target="_blank" rel="noopener" aria-label="{{ s.name }} (opens in a new tab)">{{ socialIcon(s.icon) }}</a></li>
  {%- endfor %}
</ul>
{%- endmacro -%}

{#- ---------- Page building blocks ---------- -#}

{#- button(label, url, variant, class)
    variant: "blue" (default), "navy" or "steel". -#}
{%- macro button(label, url, variant = "blue", class = "") -%}
<a class="btn btn--{{ variant }}{% if class %} {{ class }}{% endif %}" href="{{ url }}">{{ label }}</a>
{%- endmacro -%}

{#- section(variant, id, class, image, alt): a full-width background band with a centered content column.
    variant: "white" (default), "gray", "blue", "navy" or "photo".
    For "photo", pass `image` (path under src/) and `alt`; the photo sits behind a navy overlay.
    Heading accent pattern: wrap one word in <span class="accent-color">, e.g. Why <span class="accent-color">Choose</span>
    Silverscreen. It turns light steel blue on dark bands (see the Type system section at the end of site.css). -#}
{%- macro section(variant = "white", id = "", class = "", image = "", alt = "") -%}
<section class="band band--{{ variant }}{% if class %} {{ class }}{% endif %}"{% if id %} id="{{ id }}"{% endif %}>
  {%- if image %}
  <div class="band__bg">{% image image, alt, "100vw" %}</div>
  {%- endif %}
  <div class="band__inner">
    {{ caller() }}
  </div>
</section>
{%- endmacro -%}

{#- Short gradient rule under a section title. color: "blue" (default) or "white". -#}
{%- macro divider(color = "blue") -%}
<hr class="divider divider--{{ color }}">
{%- endmacro -%}

{#- card(title, icon, layout): bordered card with an icon (a name from icons.njk), title and body (caller).
    layout: "stacked" (default: icon centered above the title) or "inline" (icon beside the title, text left-aligned). -#}
{%- macro card(title, icon = "", layout = "stacked") -%}
<div class="card{% if layout == "inline" %} card--inline{% endif %}">
  {%- if icon %}{{ icons.icon(icon) }}{% endif %}
  <h3 class="card__title">{{ title }}</h3>
  <div class="card__body">{{ caller() }}</div>
</div>
{%- endmacro -%}

{#- featureRow(image, alt, title, reverse): photo beside a title and body (caller).
    `title` may contain links (it's output as HTML). reverse=true puts the photo on the right from tablet up. -#}
{%- macro featureRow(image, alt, title, reverse = false) -%}
<div class="feature{% if reverse %} feature--reverse{% endif %}">
  <div class="feature__media">{% image image, alt, "(min-width: 1025px) 557px, (min-width: 768px) 45vw, 100vw" %}</div>
  <div class="feature__text">
    <h3 class="feature__title">{{ title | safe }}</h3>
    {{ caller() }}
  </div>
</div>
{%- endmacro -%}

{#- testimonials(image, alt): gray panel with five stars, a slider of testimonial() slides (caller) and a photo. -#}
{%- macro testimonials(image, alt) -%}
<div class="testimonials">
  <div class="testimonials__media">{% image image, alt, "(min-width: 1025px) 367px, (min-width: 768px) 90vw, 100vw" %}</div>
  <div class="testimonials__main">
    {{ icons.icon("stars") }}
    <div class="slider" data-slider aria-roledescription="carousel" aria-label="Testimonials">
      <div class="slider__viewport">
        <div class="slider__track" data-slider-track>
          {{ caller() }}
        </div>
      </div>
      <div class="slider__dots" data-slider-dots></div>
    </div>
  </div>
</div>
{%- endmacro -%}

{#- testimonial(quote, name, details): one slide. Body paragraphs go in the caller.
    details: list of lines shown under the name (title, company). -#}
{%- macro testimonial(quote, name, details = []) -%}
<figure class="testimonial" data-slide role="group" aria-roledescription="slide">
  <blockquote>
    <h3 class="testimonial__quote">"{{ quote }}"</h3>
    {{ caller() }}
  </blockquote>
  <figcaption class="testimonial__cite">
    <strong>{{ name }}</strong>
    {%- for line in details %}<br><strong>{{ line }}</strong>{% endfor %}
  </figcaption>
</figure>
{%- endmacro -%}

{#- logoStrip(partners): row of partner logos that slides one logo every 7 seconds and loops,
    with previous/next arrows. Data: src/_data/partners.json. Behavior is in site.js. -#}
{%- macro logoStrip(partners) -%}
<div class="logo-strip" data-logo-strip>
  <button class="logo-strip__arrow logo-strip__arrow--prev" type="button" aria-label="Previous logos" data-logo-prev>{{ chevron() }}</button>
  <div class="logo-strip__viewport" data-logo-viewport>
    <ul class="logo-strip__list" data-logo-list>
      {%- for p in partners %}
      <li class="logo-strip__item">
        <a href="{{ p.url }}" target="_blank" rel="noopener">{% image p.image, p.name + " (opens in a new tab)", "(min-width: 1025px) 224px, (min-width: 768px) 114px, 254px" %}</a>
      </li>
      {%- endfor %}
    </ul>
  </div>
  <button class="logo-strip__arrow logo-strip__arrow--next" type="button" aria-label="Next logos" data-logo-next>{{ chevron() }}</button>
</div>
{%- endmacro -%}

{#- contactDetails(site, mapUrl): e-mail, address and phone rows with icon tiles.
    mapUrl (optional): where the address links; defaults to site.address.mapUrl. Contact Us passes its live page's own link. -#}
{%- macro contactDetails(site, mapUrl = "") -%}
<ul class="contact-details">
  <li class="contact-details__row">
    <span class="contact-details__icon">{{ icons.icon("email") }}</span>
    <div><h3 class="contact-details__label">E-mail</h3><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
  </li>
  <li class="contact-details__row">
    <span class="contact-details__icon">{{ icons.icon("pin") }}</span>
    <div><h3 class="contact-details__label">Address</h3><a href="{{ mapUrl or site.address.mapUrl }}" target="_blank" rel="noopener">{{ site.address.street }}, {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}<span class="visually-hidden"> (opens in a new tab)</span></a></div>
  </li>
  <li class="contact-details__row">
    <span class="contact-details__icon">{{ icons.icon("phone") }}</span>
    <div><h3 class="contact-details__label">Phone number</h3><a href="tel:{{ site.phone }}">{{ site.phone }}</a></div>
  </li>
</ul>
{%- endmacro -%}

{#- contactForm(site, id, messageLabel): the contact form. messageLabel: the message box's label ("Message" on the
    homepage, "How Can We Help You" on Contact Us, matching each live page).
    Posts straight to the Insightly Marketing form handler (site.insightlyContactFormUrl; see
    context/forms-insightly-integration.md), which creates the lead and then redirects the visitor to /thank-you or
    /form-error (both set in the form's settings in Insightly). The input names must match the Insightly form's field
    names exactly, case included. All six fields are required, so the browser checks them before sending. site.js only
    disables the button while the page is sending. "insightly_additional_field" is Insightly's own spam trap: people
    never see it, bots fill it in, and Insightly then drops the submission. -#}
{%- macro contactForm(site, id = "contact", messageLabel = "Message") -%}
<form class="contact-form" action="{{ site.insightlyContactFormUrl }}" method="post" aria-label="Contact Us" data-contact-form>
  <div class="contact-form__trap" aria-hidden="true">
    <label for="{{ id }}-trap">Leave this field empty</label>
    <input id="{{ id }}-trap" name="insightly_additional_field" type="text" tabindex="-1" autocomplete="off">
  </div>
  <div class="contact-form__field">
    <label for="{{ id }}-first-name">First name</label>
    <input id="{{ id }}-first-name" name="FirstName" type="text" autocomplete="given-name" required>
  </div>
  <div class="contact-form__field">
    <label for="{{ id }}-last-name">Last name</label>
    <input id="{{ id }}-last-name" name="LastName" type="text" autocomplete="family-name" required>
  </div>
  <div class="contact-form__field contact-form__field--wide">
    <label for="{{ id }}-business">Business name</label>
    <input id="{{ id }}-business" name="Business" type="text" autocomplete="organization" required>
  </div>
  <div class="contact-form__field">
    <label for="{{ id }}-email">E-mail</label>
    <input id="{{ id }}-email" name="Email" type="email" autocomplete="email" required>
  </div>
  <div class="contact-form__field">
    <label for="{{ id }}-phone">Phone</label>
    <input id="{{ id }}-phone" name="Phone" type="tel" autocomplete="tel" required>
  </div>
  <div class="contact-form__field contact-form__field--wide">
    <label for="{{ id }}-message">{{ messageLabel }}</label>
    <textarea id="{{ id }}-message" name="Message" required></textarea>
  </div>
  <button class="btn btn--navy contact-form__submit" type="submit">Send Message</button>
</form>
{%- endmacro -%}

{#- staticMap(site): Mapbox Static Images map (streets-v12, large navy pin) linking to Google Maps.
    Sizes match the live map: full width x 200px on desktop, x 300px on tablet, hidden on phones.
    The Static Images API caps images at 1280px, so wider screens scale the image up (object-fit: cover). -#}
{%- macro staticMap(site, zoom = 13) -%}
{%- set a = site.address -%}
{%- set base = "https://api.mapbox.com/styles/v1/mapbox/streets-v12/static/pin-l+002554(" + a.lng + "," + a.lat + ")/" + a.lng + "," + a.lat + "," + zoom + ",0/" -%}
{%- set token = "?access_token=" + site.mapboxToken -%}
{%- set address = a.street + ", " + a.city + ", " + a.state + " " + a.zip -%}
<a class="static-map" href="{{ a.mapUrl }}" target="_blank" rel="noopener">
  <picture>
    <source media="(min-width: 1025px)" srcset="{{ base }}1280x200{{ token }} 1x, {{ base }}1280x200@2x{{ token }} 2x" width="1280" height="200">
    <img src="{{ base }}1024x300{{ token }}" srcset="{{ base }}1024x300@2x{{ token }} 2x" width="1024" height="300" alt="Street map of south Reno with a pin at {{ address }}" loading="lazy" decoding="async">
  </picture>
  <span class="static-map__address">{{ address }} <span class="static-map__cta">Open in Google Maps<span class="visually-hidden"> (opens in a new tab)</span></span></span>
</a>
{%- endmacro -%}


{#- ---------- Service pages (Screen Printing, Embroidery, DTG, DTF, Fulfillment) ---------- -#}

{#- serviceHero(title, image, alt, wide, class): full-width photo with the page's H1 over it.
    The photo is the page's main (LCP) image, so it loads eagerly with high priority.
    wide=true lets a long title run across most of the column (Embroidery, DTG) instead of wrapping at 11em.
    class: extra class for a page's own hero sizes (Specialties).
    accent: the words at the start of `title` to color as the heading accent, e.g.
    title="Embroidery: Precision, Quality, and Scale", accent="Embroidery". The overlay then darkens behind the
    heading so the accent stays readable (.service-hero--accent in site.css). -#}
{%- macro serviceHero(title, image, alt, wide = false, class = "", accent = "") -%}
<section class="service-hero{% if wide %} service-hero--wide{% endif %}{% if accent %} service-hero--accent{% endif %}{% if class %} {{ class }}{% endif %}">
  <div class="service-hero__media">{% image image, alt, "100vw", "eager", "high" %}</div>
  <div class="service-hero__inner">
    <h1 class="service-hero__title">{% if accent and title.startsWith(accent) %}<span class="accent-color">{{ accent }}</span>{{ title.slice(accent | length) }}{% else %}{{ title }}{% endif %}</h1>
  </div>
</section>
{%- endmacro -%}

{#- serviceIntro(stat, statLabel, title): a big number ("20+") and its label beside an H2 and body (caller).
    `title` may contain the accent <span class="accent-color"> (it's output as HTML). -#}
{%- macro serviceIntro(stat, statLabel, title) -%}
<section class="band service-intro">
  <div class="band__inner service-intro__inner">
    <div class="service-intro__stat">
      <p class="service-intro__number">{{ stat }}</p>
      <p class="service-intro__label">{{ statLabel }}</p>
    </div>
    <div class="service-intro__text">
      <h2 class="service-intro__title">{{ title | safe }}</h2>
      {{ caller() }}
    </div>
  </div>
</section>
{%- endmacro -%}

{#- featurePanel(image, alt, title, band, box, reverse): a photo with a text panel (H2 + caller) overlapping it.
    `title` may contain the accent <span class="accent-color">.
    band: "blue" (default) or "white". box: "white" (default), "gray" or "navy" (the gray and navy boxes cast a shadow).
    reverse=true puts the text panel on the left and the photo on the right on desktop. -#}
{%- macro featurePanel(image, alt, title, band = "blue", box = "white", reverse = false) -%}
<section class="band band--{{ band }} feature-panel{% if box != "white" %} feature-panel--{{ box }}{% endif %}{% if reverse %} feature-panel--reverse{% endif %}">
  <div class="band__inner feature-panel__inner">
    <div class="feature-panel__media">{% image image, alt, "(min-width: 1025px) 740px, 100vw" %}</div>
    <div class="feature-panel__box">
      <h2 class="feature-panel__title">{{ title | safe }}</h2>
      {{ caller() }}
    </div>
  </div>
</section>
{%- endmacro -%}

{#- factSheet(title, url, label): navy band with a heading and a button that opens the PDF fact sheet in a new tab. -#}
{%- macro factSheet(title, url, label = "Download Information Sheet") -%}
<section class="band band--navy fact-sheet">
  <div class="band__inner fact-sheet__inner">
    <h2 class="fact-sheet__title">{{ title }}</h2>
    <a class="btn fact-sheet__button" href="{{ url }}" target="_blank" rel="noopener">{{ label }}<span class="visually-hidden"> (opens in a new tab)</span></a>
  </div>
</section>
{%- endmacro -%}

{#- photoBand(image, alt): a full-width photo strip between sections. -#}
{%- macro photoBand(image, alt) -%}
<div class="photo-band">{% image image, alt, "100vw" %}</div>
{%- endmacro -%}

{#- checkList() wraps checkItem(title) rows: a check icon, an H3 title and body (caller). -#}
{%- macro checkList() -%}
<ul class="check-list">
  {{ caller() }}
</ul>
{%- endmacro -%}

{%- macro checkItem(title) -%}
<li class="check-list__item">
  {{ icons.icon("check") }}
  <div>
    <h3 class="check-list__title">{{ title }}</h3>
    {{ caller() }}
  </div>
</li>
{%- endmacro -%}

{#- faq(items): accordion of questions (H3) and answers, built on <details> so it needs no script.
    items: the page's front matter `faq` list of { q, lead, a, list }. The FAQPage schema in seo.njk
    is built from the same list, so the two can't drift apart. `lead`, `a` and `list` may contain links
    (they're output as HTML; the schema strips the tags).
    `a`: one paragraph (a string) or several (a list of strings). `list` (optional): bullet points
    shown after the paragraphs. -#}
{%- macro faq(items) -%}
<div class="faq">
  {%- for item in items %}
  <details class="faq__item">
    <summary class="faq__summary"><h3 class="faq__question">{{ item.q }}</h3></summary>
    <div class="faq__answer">
      <p>{{ item.lead | safe }}</p>
      {%- if item.a is string %}
      <p>{{ item.a | safe }}</p>
      {%- else %}
      {%- for para in item.a %}
      <p>{{ para | safe }}</p>
      {%- endfor %}
      {%- endif %}
      {%- if item.list %}
      <ul class="faq__list">
        {%- for point in item.list %}
        <li>{{ point | safe }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </div>
  </details>
  {%- endfor %}
</div>
{%- endmacro -%}

{#- capabilities(title, lede, class): gray band with an H2 and a lead-in on the left and an arrowList (caller) on the right.
    `title` may contain the accent (it's output as HTML). Stacks below desktop.
    The lead-in has the `lead` class, which only has styles on pages on the new type system. -#}
{%- macro capabilities(title, lede, class = "") -%}
<section class="band band--gray capabilities{% if class %} {{ class }}{% endif %}">
  <div class="band__inner capabilities__inner">
    <div class="capabilities__intro">
      <h2 class="capabilities__title">{{ title | safe }}</h2>
      <p class="capabilities__lede lead">{{ lede }}</p>
    </div>
    {{ caller() }}
  </div>
</section>
{%- endmacro -%}

{#- arrowList() wraps arrowItem(title) rows: an arrow icon, an H3 title and body (caller), with a rule between rows. -#}
{%- macro arrowList() -%}
<ul class="arrow-list">
  {{ caller() }}
</ul>
{%- endmacro -%}

{%- macro arrowItem(title) -%}
<li class="arrow-list__item">
  {{ icons.icon("arrow") }}
  <div>
    <h3 class="arrow-list__title">{{ title }}</h3>
    {{ caller() }}
  </div>
</li>
{%- endmacro -%}

{#- photoRow(photos): full-width row of 2 or 3 photos with thin gaps. photos: list of { image, alt, width },
    where `width` is the photo's share of the row (e.g. 643, 451 and 317 for the live page's pixel widths).
    Phones show the first two photos side by side, like the live site. -#}
{%- macro photoRow(photos) -%}
<div class="photo-row">
  {%- for p in photos %}
  <div class="photo-row__item" style="--share: {{ p.width }}">{% image p.image, p.alt, "50vw" %}</div>
  {%- endfor %}
</div>
{%- endmacro -%}

{#- stillQuestion(title, phone, band, buttonVariant, class): closing line (H2) and a Call Now button, in a
    section() band. `title` may contain a link (it's output as HTML). band: as section(); buttonVariant: as button().
    (Written out rather than through {% call section() %}: a call body can't see this macro's default arguments.) -#}
{%- macro stillQuestion(title, phone, band = "white", buttonVariant = "navy", class = "") -%}
<section class="band band--{{ band }} still-question{% if class %} {{ class }}{% endif %}">
  <div class="band__inner">
    <h2 class="still-question__title">{{ title | safe }}</h2>
    {{ button("Call Now", "tel:" + phone, buttonVariant, "still-question__button") }}
  </div>
</section>
{%- endmacro -%}
